# Copy to .env and replace placeholders. Never commit .env.

# Required by the realtime collector.
BKK_API_KEY=paste_your_bkk_key_here
DATA_DIR=/data

# Optional but strongly recommended off-server backup. Both must be set.
HF_TOKEN=
HF_REPO_ID=your-hf-username/bkk-transit-raw

# Independent realtime cadences. Values below 5 seconds are rejected.
VEHICLE_POSITIONS_INTERVAL_SECONDS=10
TRIP_UPDATES_INTERVAL_SECONDS=10
ALERTS_INTERVAL_SECONDS=30
# Deprecated migration fallback: if set, it supplies any feed-specific value
# omitted above. Existing installations may keep it during a staged upgrade.
# POLL_INTERVAL_SECONDS=30

# Durable derived output and independently configured full raw snapshots.
PARQUET_FLUSH_MINUTES=5
TRIPUPDATES_RAW_ARCHIVE_SECONDS=300
DELAY_CHANGE_THRESHOLD_SECONDS=15
# Absolute arrival/departure prediction timestamps (BKK currently uses these
# across all observed modes while standard delay fields remain null).
TRIPUPDATE_TIME_TOLERANCE_SECONDS=5
# Independent tolerance for BKK's numeric stop_distance extension.
BKK_STOP_DISTANCE_CHANGE_THRESHOLD=15
# Fail change tracking and force raw fallback if this many consecutive parsed
# TripUpdates rows contain no delay or absolute prediction signal at all.
CHANGE_TRACKER_NULL_GUARD_ROWS=1000
HEARTBEAT_SECONDS=1800
RAW_FSYNC=true

# Set temporarily to 10 for an apples-to-apples threshold experiment. Zero
# disables the extra high-frequency TripUpdates raw archive.
TRIPUPDATES_ANALYSIS_SAMPLE_SECONDS=0

# Bounded HTTP behavior; retries are connection/read retries only, not 429/5xx.
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_CONNECT_RETRIES=1
HTTP_BACKOFF_SECONDS=0.3

# Source freshness, process absence, and disk safety thresholds.
FEED_STALE_SECONDS=180
FEED_ABSENT_SECONDS=180
FROZEN_PAYLOAD_SECONDS=300
ALERTS_FROZEN_PAYLOAD_SECONDS=86400
DISK_WARN_FREE_GB=2.0
DISK_CRITICAL_FREE_GB=0.5
HEALTH_STATUS_MAX_AGE_SECONDS=180

# Independent maintenance worker.
BACKUP_HOUR_UTC=3
BACKUP_RETRY_SECONDS=900
BACKUP_MAX_DATES_PER_RUN=7
BACKUP_DATE_GRACE_MINUTES=30
BACKUP_STALE_HOURS=48
PRUNE_LOCAL_RAW_AFTER_DAYS=14
STATIC_GTFS_CHECK_INTERVAL_SECONDS=86400
STATIC_GTFS_RETRY_SECONDS=3600
MAINTENANCE_INTERVAL_SECONDS=60
MAINTENANCE_STATUS_MAX_AGE_SECONDS=300
PARQUET_COMPACTION_ENABLED=true
PARQUET_COMPACTION_MIN_FILES=12

# Optional dead-man URL. Only maintenance calls it, and only while both
# collector and maintenance status are healthy.
HEALTHCHECK_URL=
HEALTHCHECK_PING_INTERVAL_SECONDS=300

# Optional deployment provenance recorded in daily manifests.
COLLECTOR_VERSION=2
COLLECTOR_GIT_COMMIT=unknown

# Compose container limits (limits, not reservations). Keep the defaults unless
# docker stats and workload evidence justify a change.
COLLECTOR_MEMORY_LIMIT=1536m
MAINTENANCE_MEMORY_LIMIT=1536m
