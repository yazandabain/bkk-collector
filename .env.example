# Copy this file to .env and fill in your real values. Never commit .env to git.

# Required. From https://opendata.bkk.hu/keys
BKK_API_KEY=paste_your_bkk_key_here

# Optional but strongly recommended: daily backup of the raw + parquet data
# to a private Hugging Face dataset repo, so you never depend on the VM's
# disk alone. Get a token (role: write) from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_REPO_ID=your-hf-username/bkk-transit-raw

# Usually fine to leave these at their defaults.
POLL_INTERVAL_SECONDS=30
PARQUET_FLUSH_MINUTES=5
BACKUP_HOUR_UTC=3
DISK_WARN_FREE_GB=2.0
DATA_DIR=/data

# TripUpdates is ~5MB per poll for the Budapest network (measured) -- these
# two control how much of that actually gets written to disk. See README's
# "Storage, honestly" section before changing them.
TRIPUPDATES_RAW_ARCHIVE_SECONDS=300
HEARTBEAT_SECONDS=1800

# Delay values wobble by a second or two on nearly every poll as BKK
# recalculates ETAs off live GPS. A change smaller than this many seconds
# does not count as "changed" for storage purposes. Run check_threshold.py
# against your own raw logs to validate this number.

# Local disk only needs to hold a rolling buffer -- Hugging Face holds the
# real history. Old raw files are deleted locally ONLY after they're
# confirmed uploaded. Set to 0 to keep everything locally forever (only
# sensible if you have a lot of disk).
PRUNE_LOCAL_RAW_AFTER_DAYS=14
DELAY_CHANGE_THRESHOLD_SECONDS=15

# Optional dead-man's switch. Create a check at https://healthchecks.io
# (free tier) with a period of ~1 hour, and paste its ping URL here. The
# collector pings it after every flush that actually wrote data, so you get
# an email if collection silently stops. Leave blank to disable.
HEALTHCHECK_URL=
