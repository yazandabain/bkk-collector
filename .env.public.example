# Separate from .env: no BKK, Hugging Face, or collector credentials here.
PUBLIC_PUBLISH_URL=https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev/api/publish
# Generate a random token; use the same value in the Worker PUBLISH_TOKEN secret.
PUBLIC_PUBLISH_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_EXPORT_INTERVAL_SECONDS=10
